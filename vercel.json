{
  "buildCommand": "npx vite build",
  "installCommand": "npm ci --legacy-peer-deps --ignore-scripts || npm install --legacy-peer-deps --ignore-scripts",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

