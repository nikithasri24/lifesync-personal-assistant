# LifeSync environment configuration
# Copy this file to `.env` and fill in the blanks for your environment.

# Frontend API base (falls back to http://localhost:3001/api if unset)
VITE_API_BASE_URL=

# Supabase project configuration (required for production persistence)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: service role key for local scripts/migrations only (NEVER expose in client build)
SUPABASE_SERVICE_ROLE_KEY=

# Auth redirect URL used by Supabase email confirmations (should match deployed domain)
VITE_SUPABASE_REDIRECT_URL=http://localhost:5173/auth/callback

# URL of the server-side proxy that returns YouTube snippet metadata
VITE_YOUTUBE_SNIPPET_PROXY_URL=

# Server configuration
# Comma-separated list of allowed origins for CORS (optional; when empty, all origins allowed)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Port for the API server
PORT=3001
# Skip DB connections and run only proxy/utility routes
SKIP_DB=0

# External services
# OCR.space API key (server-only). Do NOT use a VITE_ prefix here.
OCR_SPACE_API_KEY=

# Groq API key for AI-powered conversational assistant and recipe extraction
# Get your free API key at https://console.groq.com/keys
# Free tier: 14,400 requests/day, no credit card required
# If not set, the YouTube recipe extractor will fall back to regex-based parsing
GROQ_API_KEY=

# Conversational AI Configuration (Optional - defaults to free tools)
# Use 'groq' for free LLM, 'openai' or 'anthropic' for paid alternatives
VITE_LLM_PROVIDER=groq
# Voice input/output: 'web' (free browser APIs) or 'openai' (paid, higher quality)
VITE_VOICE_PROVIDER=web

# Testing and scripts
# API origin for package scripts like `npm run api:status`
API_ORIGIN=http://localhost:3001
# Playwright E2E base URL and dev command
E2E_BASE_URL=http://localhost:5173
E2E_DEV_COMMAND=npm run dev
