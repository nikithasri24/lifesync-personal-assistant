<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>LifeSync</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCalendarsUsageDescription</key>
	<string>LifeSync syncs with your calendar to show events in your daily briefing and avoid scheduling conflicts.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>LifeSync uses Face ID to protect your private journal entries and financial data.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>LifeSync reads your health data (steps, sleep, activity) to provide personalized wellness insights and track your health goals.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>LifeSync can write health data to help you track manually entered wellness metrics.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>LifeSync uses your location in the background to remind you about errands when you're near relevant stores.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>LifeSync uses your location to provide commute estimates, location-based reminders, and nearby errand suggestions.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>LifeSync needs microphone access to enable voice commands and voice notes for quick capture.</string>
	<key>NSRemindersUsageDescription</key>
	<string>LifeSync can sync with your Reminders to import and manage tasks.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>LifeSync uses speech recognition to let you create tasks, log habits, and interact with your AI assistant using your voice.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
