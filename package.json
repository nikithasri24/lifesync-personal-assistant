{
  "name": "lifesync",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "types:generate": "npx supabase gen types typescript --project-id rfwaiijodrowakcpayoa > src/types/database.types.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "cleanup:ports": "lsof -ti:3001,5173 | xargs kill -9 2>/dev/null || true",
    "version": "node scripts/version.js",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production' && !process.env.CI && !process.env.VERCEL) { try { require('child_process').execSync('husky install', {stdio:'inherit'}) } catch(e) {} }\"",
    "validate": "npm run typecheck && npm run lint && npm test -- --run",
    "api:start": "node server/dist/index.js",
    "start": "concurrently \"npm run api:start\" \"npm run dev\" --names \"API,UI\" --prefix-colors \"blue,magenta\"",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:build": "npm run build && npx cap sync",
    "cap:build:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:build:android": "npm run build && npx cap sync android && npx cap open android",
    "import:visa-data": "npx tsx scripts/import-visa-data.ts",
    "import:visa-to-db": "npx tsx scripts/import-visa-to-supabase.ts",
    "export:visa-csv": "npx tsx scripts/export-visa-to-csv.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@headlessui/react": "^2.2.7",
    "@sentry/react": "^10.39.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.10",
    "@tiptap/pm": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "@types/dompurify": "^3.0.5",
    "@types/leaflet": "^1.9.21",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "express": "^5.1.0",
    "framer-motion": "^12.23.26",
    "groq-sdk": "^0.36.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.542.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-day-picker": "^8.9.1",
    "react-dom": "^19.1.1",
    "react-is": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.2.1",
    "topojson-client": "^3.1.0",
    "web-vitals": "^5.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  }
}
