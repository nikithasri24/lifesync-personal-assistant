{
  "name": "lifesync",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:server": "vitest --config vitest.config.server.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "test:project-tracking": "vitest --config ./vitest.config.projecttracking.ts src/pages/__tests__/ProjectTracking*.test.tsx",
    "test:project-tracking:watch": "vitest --config ./vitest.config.projecttracking.ts src/pages/__tests__/ProjectTracking*.test.tsx --watch",
    "test:project-tracking:coverage": "vitest --config ./vitest.config.projecttracking.ts src/pages/__tests__/ProjectTracking*.test.tsx --coverage",
    "test:project-tracking:ui": "vitest --config ./vitest.config.projecttracking.ts src/pages/__tests__/ProjectTracking*.test.tsx --ui",
    "version": "node scripts/version.js",
    "version:bump": "node scripts/version.js bump",
    "version:bump:major": "node scripts/version.js bump major",
    "version:bump:minor": "node scripts/version.js bump minor",
    "version:bump:patch": "node scripts/version.js bump patch",
    "version:generate": "node scripts/version.js generate",
    "version:history": "node scripts/version.js history",
    "release:prepare": "npm run lint && npm run test && npm run version:generate && npm run build",
    "api:build": "tsc -p server/tsconfig.json",
    "api:serve": "node server/dist/index.js",
    "api:start": "npm run api:build && npm run api:serve",
    "api:status": "sh -c 'curl -s ${API_ORIGIN:-http://localhost:3001}/api/health | jq .'",
    "start:local": "./start-local.sh",
    "start:external": "./start-external.sh",
    "dev:external": "vite --host 0.0.0.0 --port 5173",
    "diagnose:full": "node diagnose.js full",
    "diagnose:api": "node diagnose.js api",
    "diagnose:db": "node diagnose.js db",
    "diagnose:sync": "node diagnose.js sync",
    "diagnose:ports": "node diagnose.js ports",
    "fix:all": "node autofix.js all",
    "fix:ports": "node autofix.js ports",
    "fix:config": "node autofix.js config",
    "fix:services": "node autofix.js services",
    "verify:supabase-schema": "node scripts/verifySupabaseSchema.mjs",
    "backup:supabase-schema": "node scripts/backupSupabaseSchema.mjs",
    "data:generate:countries": "node scripts/generate-countries.mjs",
    "data:download:world-geojson": "node scripts/download-world-geojson.mjs",
    "data:download:us-geojson": "node scripts/download-us-states-geojson.mjs",
    "data:download:canada-geojson": "node scripts/download-canada-provinces-geojson.mjs",
    "data:download:india-geojson": "node scripts/download-india-states-geojson.mjs",
    "migrate:75hard": "tsx src/scripts/migrate75HardData.ts",
    "validate:75hard": "tsx src/scripts/validate75HardMigration.ts",
    "cleanup:ports": "lsof -ti:3001,5173 | xargs kill -9 2>/dev/null || true",
    "api:restart": "npm run cleanup:ports && npm run api:start",
    "status": "node diagnose.js full",
    "watch:unit": "vitest --watch",
    "watch:type": "tsc -b -w",
    "guard": "concurrently -k -n type,unit \"npm:watch:type\" \"npm:watch:unit\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.7",
    "@supabase/supabase-js": "^2.57.4",
    "@tiptap/pm": "^3.4.0",
    "@tiptap/react": "^3.4.0",
    "@tiptap/starter-kit": "^3.4.0",
    "@types/leaflet": "^1.9.20",
    "@types/pg": "^8.15.5",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.542.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-day-picker": "^8.9.1",
    "react-dom": "^19.1.1",
    "react-is": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.2.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^16.4.5",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  }
}
